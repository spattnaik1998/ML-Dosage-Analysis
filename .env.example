# ============================================================================
# LLM API KEYS (REQUIRED)
# ============================================================================
# Get your API keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Google AI Studio: https://makersuite.google.com/app/apikey
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Serper for web search (if using search features)
SERPER_API_KEY=your_serper_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================
# Path to the trained Decision Tree model
MODEL_PATH=best_dt_classifier_model.joblib

# Primary LLM provider for extraction (openai or gemini)
PRIMARY_LLM_PROVIDER=openai

# Fallback LLM provider if primary fails (openai or gemini)
FALLBACK_LLM_PROVIDER=gemini

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================
# Model options: gpt-4o (recommended), o1, o1-preview, gpt-4-turbo
# gpt-4o is recommended for structured extraction tasks
OPENAI_MODEL=gpt-4o

# Temperature for OpenAI (0.0 = deterministic, 2.0 = creative)
OPENAI_TEMPERATURE=0.0

# ============================================================================
# GOOGLE GEMINI CONFIGURATION
# ============================================================================
# Model options: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash-exp

# Temperature for Gemini (0.0 = deterministic, 2.0 = creative)
GEMINI_TEMPERATURE=0.0

# Cache Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_HOURS=24

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/hospital_predictions

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
